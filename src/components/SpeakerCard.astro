---
interface Props {
  name: string;
  slug: string;
  photo: string;
  knownFor: string;
  index: number;
}

const { name, slug, photo, knownFor, index } = Astro.props;

const hasPhoto = photo && !photo.includes('Platzhalter') && !photo.includes('passport');

// Rotating background colors for cards
const bgColors = [
  'from-deep-navy to-slate-blue',
  'from-charcoal to-deep-navy',
  'from-slate-blue to-charcoal',
  'from-deep-navy/80 to-charcoal',
];
const bgColor = bgColors[index % bgColors.length];
---

<a
  href={`/sprecher/${slug}/`}
  class="group relative block overflow-hidden rounded-lg bg-rich-black aspect-[3/4] animate-on-scroll"
  style={`animation-delay: ${Math.min(index * 0.05, 0.5)}s`}
>
  {/* Background gradient */}
  <div class:list={['absolute inset-0 bg-gradient-to-br opacity-60', bgColor]}></div>

  {/* Photo or placeholder */}
  {hasPhoto ? (
    <img
      src={photo}
      alt={name}
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
    />
  ) : (
    <div class="absolute inset-0 flex items-center justify-center">
      <svg class="w-24 h-24 text-off-white/10" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
      </svg>
    </div>
  )}

  {/* Gradient overlay for text readability */}
  <div class="absolute inset-0 bg-gradient-to-t from-deep-black/90 via-deep-black/20 to-transparent"></div>

  {/* Hover gold glow */}
  <div class="absolute inset-0 border-2 border-transparent group-hover:border-studio-gold/50 rounded-lg transition-all duration-500 group-hover:shadow-[inset_0_0_30px_rgba(200,164,78,0.1)]"></div>

  {/* Content */}
  <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-5">
    <h3 class="font-display text-lg sm:text-xl text-off-white group-hover:text-gold-light transition-colors duration-300">
      {name}
    </h3>
    {knownFor && (
      <p class="mt-1 text-xs sm:text-sm text-off-white/50 font-body font-light line-clamp-1">
        {knownFor}
      </p>
    )}

    {/* View profile indicator */}
    <div class="mt-3 flex items-center gap-2 text-studio-gold text-sm font-body opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300">
      <span>Profil ansehen</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>
