---
import Logo from './Logo.astro';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  {/* Background atmospheric effect */}
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-deep-black"></div>
    {/* Subtle radial gradient for depth */}
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(200,164,78,0.03)_0%,_transparent_70%)]"></div>
    {/* Subtle grid pattern */}
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(232,232,240,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(232,232,240,0.1) 1px, transparent 1px); background-size: 60px 60px;"></div>
    {/* Atmospheric sound wave lines */}
    <div class="absolute top-1/2 left-0 right-0 -translate-y-1/2 h-px bg-gradient-to-r from-transparent via-studio-gold/10 to-transparent"></div>
    <div class="absolute top-[45%] left-0 right-0 h-px bg-gradient-to-r from-transparent via-studio-gold/5 to-transparent"></div>
    <div class="absolute top-[55%] left-0 right-0 h-px bg-gradient-to-r from-transparent via-studio-gold/5 to-transparent"></div>
  </div>

  {/* Content */}
  <div class="relative z-10 text-center px-4">
    <div class="mb-8 flex justify-center">
      <Logo size="lg" />
    </div>

    <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-off-white leading-tight max-w-4xl mx-auto">
      Die besten Sprecher/innen<br />Deutschlands.
      <span class="text-studio-gold italic"> An einem Ort.</span>
    </h1>

    <p class="mt-6 text-off-white/50 font-body text-base sm:text-lg max-w-2xl mx-auto font-light">
      Premium Synchronsprecher für Film, Fernsehen und Medien
    </p>
  </div>

  {/* Scroll indicator */}
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-off-white/30 text-xs tracking-widest uppercase font-body">Entdecken</span>
    <svg class="w-5 h-5 text-studio-gold/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
