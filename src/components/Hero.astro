---
// Hero — full-bleed dark panel with breathing multi-harmonic soundwave behind serif headline.
// The wave path is generated server-side at build time so there's no runtime cost.

const W = 1600;
const H = 400;
const N = 240;

let path = `M 0 ${H / 2}`;
for (let i = 1; i <= N; i++) {
  const x = (i / N) * W;
  const t = (i / N) * Math.PI * 2;
  const y =
    H / 2 +
    Math.sin(t * 1.0) * 70 +
    Math.sin(t * 2.3 + 0.7) * 38 +
    Math.sin(t * 4.1 + 1.4) * 18 +
    Math.sin(t * 7.7 + 2.1) * 9;
  path += ` L ${x.toFixed(2)} ${y.toFixed(2)}`;
}
---

<section class="hero" id="hero">
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
      <defs>
        <linearGradient id="wgrad" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#C8A44E" stop-opacity="0" />
          <stop offset="20%" stop-color="#C8A44E" stop-opacity="0.45" />
          <stop offset="50%" stop-color="#E8E8F0" stop-opacity="0.55" />
          <stop offset="80%" stop-color="#C8A44E" stop-opacity="0.45" />
          <stop offset="100%" stop-color="#C8A44E" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="wgrad2" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#C8A44E" stop-opacity="0" />
          <stop offset="50%" stop-color="#C8A44E" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#C8A44E" stop-opacity="0" />
        </linearGradient>
      </defs>
      <g class="breathe">
        <path d={path} fill="none" stroke="url(#wgrad2)" stroke-width="2.5" opacity="0.55" />
        <path d={path} fill="none" stroke="url(#wgrad)" stroke-width="1" />
      </g>
    </svg>
  </div>

  <div class="hero-inner">
    <div class="hero-tag">
      <span>Synchronsprecher-Agentur · Berlin · Est. 1999</span>
    </div>
    <h1>
      Die <span class="gold">besten</span> Sprecher &amp; Sprecherinnen
      <span class="small">Deutschlands. Buchbar an einem Ort.</span>
    </h1>
    <p class="hero-sub">
      Eine Auswahl deutscher Stimmen für Kino, Film, Serie, Streaming, Werbung,
      Computer&shy;spiele, Dokumentationen und Hörbuch — vermittelt mit der
      Sorgfalt, die einer Hauptbesetzung gebührt.
    </p>
  </div>

  <div class="hero-meta">
    <div>AOV / 2026 / Berlin</div>
    <div class="scroll-cue">
      <span>Scroll</span>
      <span class="scroll-line"></span>
    </div>
    <div>Berlin · 52.5200° N</div>
  </div>
</section>
