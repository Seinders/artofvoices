---
// Three-stat bar — gold-emphasised numerals with thin dividers between columns.
// Speaker count is derived from the data so it never drifts as the roster grows.
import { getSpeakers } from '../data/speakers';
const speakerCount = getSpeakers().length;
---

<section class="stats" aria-label="Kennzahlen">
  <div class="stats-row">
    <div class="stat">
      <div class="stat-num"><em>{speakerCount}</em></div>
      <div class="stat-lbl">Sprecher / Sprecherinnen</div>
    </div>
    <div class="stat">
      <div class="stat-num"><em>1000</em>+</div>
      <div class="stat-lbl">Produktionen</div>
    </div>
    <div class="stat">
      <div class="stat-num">seit <em>1999</em></div>
      <div class="stat-lbl">Berlin · Mitte</div>
    </div>
  </div>
</section>
