---
// Three-stat bar — gold-emphasised numerals with thin dividers between columns.
---

<section class="stats" aria-label="Kennzahlen">
  <div class="stats-row">
    <div class="stat">
      <div class="stat-num"><em>28</em></div>
      <div class="stat-lbl">Sprecher / Sprecherinnen</div>
    </div>
    <div class="stat">
      <div class="stat-num"><em>1000</em>+</div>
      <div class="stat-lbl">Produktionen</div>
    </div>
    <div class="stat">
      <div class="stat-num">seit <em>2017</em></div>
      <div class="stat-lbl">Berlin · Mitte</div>
    </div>
  </div>
</section>
