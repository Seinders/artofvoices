---
// About — eyebrow + lead on the left, body copy + key/value aside on the right.

const lead = "Wir vertreten keine Stimmen. Wir kuratieren ein";

const body = [
  "Art of Voices ist eine inhabergeführte Agentur in Berlin, gegründet 2017. Unser Roster umfasst 28 Sprecher/innen — bewusst klein gehalten, sorgfältig zusammengestellt, mit Bedacht erweitert.",
  "Jede Stimme in dieser Liste hat einen Platz, weil sie eine Rolle ausfüllt, die keine andere ausfüllen kann. Wir lehnen mehr Anfragen ab, als wir annehmen. Die, die wir annehmen, behandeln wir mit der Aufmerksamkeit, die einer Hauptbesetzung zusteht.",
  "Für Regisseur/innen, Tonmeister/innen und Producer bedeutet das: keine endlosen Demobänder. Eine Anfrage. Eine kuratierte Auswahl. Saubere Buchung.",
];

const aside = [
  { k: "Sitz", v: "Berlin · Mitte" },
  { k: "Gegründet", v: "2017" },
  { k: "Sprachen", v: "DE · EN · FR" },
  { k: "Roster", v: "28 Sprecher/innen" },
];
---

<section class="about" id="about">
  <div class="about-grid">
    <div>
      <div class="eyebrow">01 — Philosophie</div>
      <p class="lead">{lead} <em>Ensemble.</em></p>
    </div>
    <div class="about-body">
      {body.map((p) => <p>{p}</p>)}
      <div class="about-aside">
        {aside.map((a) => (
          <div>
            <div class="k">{a.k}</div>
            <div class="v">{a.v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
