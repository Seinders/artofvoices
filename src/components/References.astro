---
// References — clients grouped into tiers, with a scrolling ticker of the long tail.
//
// Section visibility flags — flip to false to hide a group again.
const showHighlightStudios = true;
const showStreaming = true;

// Highlight Studios
const highlightStudios = [
  { name: 'FFS GmbH', city: 'Berlin · München' },
  { name: 'Eva Studios', city: '' },
  { name: 'Interopa Film GmbH', city: 'Berlin' },
  { name: 'Iyuno', city: 'Berlin · München' },
  { name: 'Dubbing Brothers', city: '' },
];

// Major Studios
const majorStudios = [
  { name: 'Arena Film Synchron', city: '' },
  { name: 'VSI', city: '' },
  { name: 'Cinephon', city: '' },
  { name: 'Studio Hamburg', city: 'Berlin · Hamburg' },
  { name: 'EuroSync', city: '' },
  { name: 'Splendid Synchron', city: 'Berlin · Köln' },
];

// Streaming platforms (named, not branded)
const streamers = [
  { name: 'Netflix' },
  { name: 'Amazon Prime' },
  { name: 'Disney+' },
  { name: 'Apple TV' },
  { name: 'Paramount+' },
  { name: 'HBO Max' },
  { name: 'Sky' },
];

// Ticker — the long tail of clients from artofvoices.de/referenzen/, plus the
// studios not shown as a Major Studio card so none are lost.
const ticker = [
  'Anakan',
  'Antares Film',
  'Argon Hörbuch Verlag',
  'Bavaria Film München',
  'BB Radio',
  'Berliner Synchron AG',
  'Blaue Töne Wien',
  'Christa Kistner Synchron',
  'CSC Studios Hamburg',
  'CTV Media Pro',
  'Deutsche Synchron Gesellschaft',
  'Deutsche Welle',
  'Deutschland Radio',
  'DMT Hamburg',
  'Dreiklang Düsseldorf',
  'Fährhauston Hamburg',
  'Fundamental Studios Frankfurt',
  'G & G Studios',
  'Gieising Team München',
  'Hamburger Synchron GmbH',
  'Hastings Berlin',
  'Hastings Düsseldorf',
  'Hastings Hamburg',
  'Hermes Synchron GmbH',
  'Herold Studios Frankfurt',
  'Hörspielstudio Berlin',
  'Kiddinx',
  'Krane und Rabe',
  'Lavendel Film',
  'Level 45',
  'Linaro Film München',
  'Logo Synchron Köln',
  'Loft Tonstudios',
  'M & S Studios Offenbach',
  'M Sound München',
  'Medien Kontor',
  'MG Soundstudios Wien',
  'MO Synchron München',
  'Mouse Power GmbH',
  'Neue TonFilm München',
  'NHB Berlin · Hamburg',
  'Odd One Audio Recording',
  'Plan 1 München',
  'Pro 7',
  'Radio Berlin Brandenburg',
  'Rainer Brandt Film',
  'Random House',
  'RC Production',
  'Rotor Film Babelsberg GmbH',
  'RRP Media',
  'Sat 1',
  'Scala Media',
  'Spree Radio',
  'Studio Ahlberg Hamburg',
  'Studio Funk Berlin',
  'Studio Funk Düsseldorf',
  'Studio Funk Frankfurt',
  'Studio Funk Hamburg',
  'Synchron- und Tonstudio Leipzig',
  'Taunus Film',
  'Taurus Media München',
  'Tonbüro Berlin',
  'Tonstudio Holly Wien',
  'West Deutscher Rundfunk',
  '2 day Productions',
  '4 real Media Offenbach',
];

const tickerItems = [...ticker, ...ticker];
---

<section class="references" id="referenzen">
  <div class="refs-head">
    <div class="eyebrow">Referenzen</div>
    <h2 class="section-title">
      Unsere Kunden, Studios und Plattformen,<br />
      die <em>Maßstäbe</em> setzen.
    </h2>
  </div>

  {showHighlightStudios && (
    <div class="refs-tier">
      <div class="label-col">
        <h3>Highlight Studios</h3>
        <p>Langjährige Partnerschaften mit den führenden Synchronstudios Deutschlands.</p>
      </div>
      <div class="items">
        {highlightStudios.map((s) => (
          <div class="ref-item tier-1">
            <span class="name">{s.name}</span>
            {s.city && <span class="meta">{s.city}</span>}
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="refs-tier">
    <div class="label-col">
      <h3>Major Studios</h3>
      <p>Wiederkehrende Aufträge der größten Synchron- und Medienhäuser.</p>
    </div>
    <div class="items">
      {majorStudios.map((s) => (
        <div class="ref-item">
          <span class="name">{s.name}</span>
          {s.city && <span class="meta">{s.city}</span>}
        </div>
      ))}
    </div>
  </div>

  {showStreaming && (
    <div class="refs-tier">
      <div class="label-col">
        <h3>Streaming</h3>
        <p>Plattformen, für deren deutsche Fassungen unsere Stimmen besetzt sind.</p>
      </div>
      <div class="items">
        {streamers.map((s) => (
          <div class="ref-item tier-stream">
            <span class="name">{s.name}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-track">
      {tickerItems.map((t) => (
        <span class="ticker-item">{t}</span>
      ))}
    </div>
  </div>
</section>
