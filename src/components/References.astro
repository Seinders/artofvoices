---
// References — three-tier table-of-clients with a ticker of additional studios at the bottom.

const tier1 = [
  { name: 'FFS Film- & Fernseh-Synchron', city: 'München' },
  { name: 'Interopa Film', city: 'Berlin' },
  { name: 'Arena Film', city: 'Hamburg' },
  { name: 'Eva Studios', city: 'Berlin' },
];

const tier2 = [
  { name: 'Berliner Synchron', city: 'Berlin' },
  { name: 'Bavaria Synchron', city: 'München' },
  { name: 'Sky Deutschland', city: 'Unterföhring' },
  { name: 'Cinephon', city: 'Berlin' },
  { name: 'Splendid Synchron', city: 'Köln' },
  { name: 'RC Production', city: 'Berlin' },
];

const streamers = [
  { name: 'Netflix' },
  { name: 'Paramount+' },
  { name: 'Apple TV+' },
  { name: 'HBO' },
  { name: 'Disney+' },
  { name: 'Prime Video' },
];

const ticker = [
  'Studio Hamburg', 'Tonstudio Lärm & Liebe', 'Scalamedia', 'VSI Berlin', 'Iyuno-SDI',
  'Mosaic Film', 'Antares Film', 'Christa Kistner Synchronproduktion',
  'Cine-Adaption', 'Deutsche Synchron Film', 'Elektrofilm Postproduction',
  'Hermes Synchron', 'Lavendelfilm', 'Leyhausen Sound',
  'Liquid Audio', 'Macromedia', 'Magellan Film', 'Metz-Neun',
  'Neue Tonfilm München', 'Plazma', 'Pumpkin Pie', 'RTL Studios',
  'Soundvision', 'Studio Babelsberg', 'TaunusFilm Synchron',
  'Telesynchron', 'Tonstudio Ohrenschmaus', 'Trickompany',
  'Universum Film', 'VSP', 'Warner Bros. Tonstudios',
  'X-Filme', 'ZDF Studios', 'ZGS Audio', 'Lautwerk', 'Hörspielhaus',
  'Studio Funk', 'Tonewerk', 'Glanz & Gloria', 'MEDIA Synchron',
];

const tickerItems = [...ticker, ...ticker];
---

<section class="references" id="referenzen">
  <div class="refs-head">
    <div class="eyebrow">03 — Referenzen</div>
    <h2 class="section-title">
      Unsere Kunden, Studios und Plattformen,<br />
      die <em>Maßstäbe</em> setzen.
    </h2>
  </div>

  <div class="refs-tier">
    <div class="label-col">
      <div class="num">Tier 01</div>
      <h3>Highlight Studios</h3>
      <p>Langjährige Partnerschaften mit den führenden Synchronstudios Deutschlands.</p>
    </div>
    <div class="items">
      {tier1.map((s) => (
        <div class="ref-item tier-1">
          <span class="name">{s.name}</span>
          <span class="meta">{s.city}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="refs-tier">
    <div class="label-col">
      <div class="num">Tier 02</div>
      <h3>Major Studios</h3>
      <p>Wiederkehrende Aufträge der größten Synchron- und Medienhäuser.</p>
    </div>
    <div class="items">
      {tier2.map((s) => (
        <div class="ref-item">
          <span class="name">{s.name}</span>
          <span class="meta">{s.city}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="refs-tier">
    <div class="label-col">
      <div class="num">Tier 03</div>
      <h3>Streaming</h3>
      <p>Plattformen, für deren deutsche Fassungen unsere Stimmen besetzt sind.</p>
    </div>
    <div class="items">
      {streamers.map((s) => (
        <div class="ref-item tier-stream">
          <span class="name">{s.name}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-track">
      {tickerItems.map((t) => (
        <span class="ticker-item">{t}</span>
      ))}
    </div>
  </div>
</section>
