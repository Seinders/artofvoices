---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import Footer from '../../components/Footer.astro';
import { getSpeakers, getSpeakerBySlug } from '../../data/speakers';
import { getProjectsForSpeaker } from '../../data/projects';

export function getStaticPaths() {
  const speakers = getSpeakers();
  return speakers.map((speaker) => ({
    params: { slug: speaker.slug },
  }));
}

const { slug } = Astro.params;
const speaker = getSpeakerBySlug(slug!);

if (!speaker) {
  return Astro.redirect('/');
}

const projects = getProjectsForSpeaker(slug!);
const hasPhoto = speaker.photo && !speaker.photo.includes('Platzhalter') && !speaker.photo.includes('passport');
const hasAudio = speaker.audios && speaker.audios.length > 0;
const hasProjects = projects && (
  projects.top5.some(p => !p.title.includes('PLATZHALTER')) ||
  projects.recent.some(p => !p.title.includes('PLATZHALTER'))
);

// Build known_for descriptor
const knownForText = speaker.known_for
  ? `Deutsche Stimme von ${speaker.known_for.split(',')[0].trim()}`
  : '';

// Background colors for profile header
const bgColors = [
  'from-deep-navy via-slate-blue/50 to-deep-black',
  'from-slate-blue via-deep-navy/50 to-deep-black',
  'from-charcoal via-deep-navy/50 to-deep-black',
];
const bgColor = bgColors[slug!.charCodeAt(0) % bgColors.length];
---

<Layout
  title={`${speaker.name} - Art of Voices`}
  description={`${speaker.name} - Professionelle/r Synchronsprecher/in bei Art of Voices. ${knownForText}`}
>
  <Navigation />

  <main class="pt-20">
    {/* Speaker Header */}
    <section class="relative min-h-[60vh] flex items-end overflow-hidden">
      <div class:list={['absolute inset-0 bg-gradient-to-b', bgColor]}></div>

      {/* Decorative waveform lines */}
      <div class="absolute inset-0 opacity-5">
        <div class="absolute top-1/3 left-0 right-0 h-px bg-gradient-to-r from-transparent via-studio-gold to-transparent"></div>
        <div class="absolute top-1/2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-off-white to-transparent"></div>
        <div class="absolute top-2/3 left-0 right-0 h-px bg-gradient-to-r from-transparent via-studio-gold to-transparent"></div>
      </div>

      {/* Gold accent glow behind photo area */}
      <div class="absolute bottom-0 left-1/4 w-64 h-64 bg-studio-gold/5 rounded-full blur-[100px]"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-16 pt-32">
        <div class="flex flex-col md:flex-row items-end gap-8 md:gap-12">
          {/* Photo with colored background cutout */}
          <div class="flex-shrink-0 relative">
            {/* Background cutout shape */}
            <div class="absolute -inset-3 bg-gradient-to-br from-studio-gold/20 via-slate-blue/30 to-transparent rounded-xl -rotate-2"></div>
            <div class="relative w-48 h-64 sm:w-56 sm:h-72 md:w-64 md:h-80 rounded-lg overflow-hidden shadow-2xl border border-studio-gold/10">
              {hasPhoto ? (
                <img
                  src={speaker.photo}
                  alt={speaker.name}
                  class="absolute inset-0 w-full h-full object-cover object-top"
                  loading="eager"
                />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-charcoal to-deep-navy flex items-center justify-center">
                  <svg class="w-20 h-20 text-off-white/10" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                  </svg>
                </div>
              )}
              {/* Gold accent line at bottom */}
              <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-studio-gold to-gold-light"></div>
            </div>
          </div>

          {/* Name and descriptor */}
          <div class="pb-2">
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-off-white mb-3">
              {speaker.name}
            </h1>
            {knownForText && (
              <p class="text-studio-gold font-body text-lg font-light italic">
                {knownForText}
              </p>
            )}
          </div>
        </div>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">
      {/* Top 5 Projects */}
      {hasProjects && projects && projects.top5.some(p => !p.title.includes('PLATZHALTER')) && (
        <section>
          <h2 class="font-display text-2xl sm:text-3xl text-off-white mb-2">
            Größte <span class="text-studio-gold italic">Projekte</span>
          </h2>
          <div class="w-12 h-0.5 bg-studio-gold mb-8"></div>
          <div class="grid gap-4">
            {projects.top5
              .filter(p => !p.title.includes('PLATZHALTER'))
              .map((project) => (
                <div class="bg-rich-black rounded-lg border border-studio-gold/10 p-5 hover:border-studio-gold/30 transition-all duration-300">
                  <h3 class="font-display text-lg text-off-white">{project.title}</h3>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-sm font-body">
                    {project.actor && (
                      <span class="text-off-white/60">
                        <span class="text-studio-gold/60">Für:</span> {project.actor}
                      </span>
                    )}
                    {project.studio && (
                      <span class="text-off-white/60">
                        <span class="text-studio-gold/60">Studio:</span> {project.studio}
                      </span>
                    )}
                  </div>
                </div>
              ))}
          </div>
        </section>
      )}

      {/* Recent Projects */}
      {hasProjects && projects && projects.recent.some(p => !p.title.includes('PLATZHALTER')) && (
        <section>
          <h2 class="font-display text-2xl sm:text-3xl text-off-white mb-2">
            Aktuelle <span class="text-studio-gold italic">Projekte</span>
          </h2>
          <div class="w-12 h-0.5 bg-studio-gold mb-8"></div>
          <div class="space-y-3">
            {projects.recent
              .filter(p => !p.title.includes('PLATZHALTER'))
              .map((project) => (
                <div class="flex items-center gap-4 py-3 border-b border-off-white/5 last:border-0">
                  {project.year && (
                    <span class="font-mono text-sm text-studio-gold/60 w-12 flex-shrink-0">
                      {project.year}
                    </span>
                  )}
                  <span class="text-off-white/80 font-body">{project.title}</span>
                </div>
              ))}
          </div>

          {speaker.synchronkarteiUrl && (
            <a
              href={speaker.synchronkarteiUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-6 text-studio-gold hover:text-gold-light font-body text-sm transition-colors duration-300"
            >
              Komplette Filmografie ansehen
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </section>
      )}

      {/* Show Synchronkartei link even if no projects yet */}
      {!hasProjects && speaker.synchronkarteiUrl && (
        <section>
          <h2 class="font-display text-2xl sm:text-3xl text-off-white mb-2">
            Filmografie
          </h2>
          <div class="w-12 h-0.5 bg-studio-gold mb-8"></div>
          <a
            href={speaker.synchronkarteiUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-studio-gold hover:text-gold-light font-body transition-colors duration-300"
          >
            Komplette Filmografie auf Synchronkartei.de ansehen
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </section>
      )}

      {/* Biography */}
      {speaker.bio && (
        <section>
          <h2 class="font-display text-2xl sm:text-3xl text-off-white mb-2">
            Biografie
          </h2>
          <div class="w-12 h-0.5 bg-studio-gold mb-8"></div>
          <p class="text-off-white/70 font-body text-base leading-relaxed font-light">
            {speaker.bio}
          </p>
        </section>
      )}

      {/* Voice Sample */}
      {hasAudio && (
        <section>
          <h2 class="font-display text-2xl sm:text-3xl text-off-white mb-2">
            Sprach<span class="text-studio-gold italic">probe</span>
          </h2>
          <div class="w-12 h-0.5 bg-studio-gold mb-8"></div>
          <AudioPlayer audioUrl={speaker.audios[0]} speakerName={speaker.name} />
        </section>
      )}

      {/* Back navigation */}
      <div class="pt-8 border-t border-off-white/5">
        <a
          href="/#roster"
          class="inline-flex items-center gap-2 text-off-white/50 hover:text-studio-gold font-body transition-colors duration-300 group"
        >
          <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Zurück zu allen Sprechern
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Scroll-triggered animations for profile page
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
  );

  document.querySelectorAll('.animate-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>
