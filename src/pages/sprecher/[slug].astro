<script>
  // Single dossier audio player: play/pause + waveform progress fill + playhead.
  // Guarded on element existence, so it safely no-ops on speakers without audio.
  {
    const section = document.getElementById('audio-section');
    const audio = document.getElementById('speaker-audio') as HTMLAudioElement | null;
    const btn = document.getElementById('play-btn');
    const wave = document.getElementById('big-wave');
    const head = document.getElementById('wave-head');

    if (section && audio && btn && wave) {
      const bars = Array.from(wave.querySelectorAll('.b')) as HTMLElement[];
      const playIcon = btn.querySelector('.ic-play') as HTMLElement | null;
      const pauseIcon = btn.querySelector('.ic-pause') as HTMLElement | null;
      const timeEls = Array.from(section.querySelectorAll('.wave-time')) as HTMLElement[];
      const midEl = section.querySelector('.wave-time-mid') as HTMLElement | null;
      const durEl = section.querySelector('.wave-dur') as HTMLElement | null;

      const fmt = (t: number) => {
        if (!isFinite(t)) return '0:00';
        const m = Math.floor(t / 60);
        const s = Math.floor(t % 60);
        return `${m}:${String(s).padStart(2, '0')}`;
      };

      audio.addEventListener('loadedmetadata', () => {
        if (durEl) durEl.textContent = fmt(audio.duration);
        if (midEl) midEl.textContent = fmt(audio.duration / 2);
      });

      const render = () => {
        const p = audio.duration ? audio.currentTime / audio.duration : 0;
        const headIdx = Math.floor(p * bars.length);
        bars.forEach((b, i) => b.classList.toggle('on', i <= headIdx));
        if (head) head.style.left = `${p * 100}%`;
        timeEls.forEach((el) => (el.textContent = fmt(audio.currentTime)));
      };

      const setPlaying = (on: boolean) => {
        btn.classList.toggle('playing', on);
        if (playIcon) playIcon.style.display = on ? 'none' : '';
        if (pauseIcon) pauseIcon.style.display = on ? '' : 'none';
      };

      btn.addEventListener('click', () => {
        if (audio.paused) audio.play(); else audio.pause();
      });
      audio.addEventListener('play', () => setPlaying(true));
      audio.addEventListener('pause', () => setPlaying(false));
      audio.addEventListener('timeupdate', render);
      audio.addEventListener('ended', () => { setPlaying(false); render(); });

      // Seek by clicking the waveform
      wave.addEventListener('click', (e) => {
        const rect = wave.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
        if (audio.duration) audio.currentTime = ratio * audio.duration;
      });
    }
  }
</script>
