---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getSpeakers, getSpeakerBySlug } from '../../data/speakers';

export function getStaticPaths() {
  const speakers = getSpeakers();
  return speakers.map((speaker) => ({
    params: { slug: speaker.slug },
  }));
}

const { slug } = Astro.params;
const speaker = getSpeakerBySlug(slug!);

if (!speaker) {
  return Astro.redirect('/');
}

// ---- Derived, honest data only (no fabricated stats) ----
const hasPhoto =
  speaker.photo &&
  !speaker.photo.includes('Platzhalter') &&
  !speaker.photo.includes('passport');
const hasAudio = !!speaker.audio;

// Name split: first token vs. the rest
const nameParts = speaker.name.trim().split(/\s+/);
const firstName = nameParts[0];
const lastName = nameParts.slice(1).join(' ');
const initials = (firstName[0] + (lastName ? lastName[0] : (nameParts[1]?.[0] ?? ''))).toUpperCase();

// Known-for actors (real data) → role line + role index
const knownForActors = (speaker.known_for || '')
  .split(',')
  .map((a) => a.trim())
  .filter(Boolean);
const primaryActor = knownForActors[0] ?? '';

const genderLabel = speaker.gender === 'F' ? 'Frauen' : 'Männer';

// Voice "Fach" derived deterministically from name+gender — kept consistent
// with the roster card tags. Qualitative editorial classification, not a
// measured claim.
function nameHash(name: string): number {
  let h = 0;
  for (let i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
  return h || 1;
}
const h = nameHash(speaker.name);
let fach: string;
if (speaker.gender === 'M') {
  fach = h % 3 === 0 ? 'Tenor' : 'Bariton';
} else {
  fach = h % 3 === 0 ? 'Sopran' : 'Mezzosopran';
}

// Deterministic waveform bars for the audio player (stable per speaker)
function buildBars(seed: number, n: number): number[] {
  let s = seed;
  const r = () => { s = (s * 9301 + 49297) % 233280; return s / 233280; };
  const out: number[] = [];
  for (let i = 0; i < n; i++) {
    const env = Math.sin((i / n) * Math.PI);
    out.push(Math.max(0.08, Math.min(1, 0.15 + env * 0.55 + r() * 0.4)));
  }
  return out;
}
const bigBars = buildBars(h, 96);

// Voice classification: use the manual override if set, else the derived Fach.
const stimmlage = speaker.stimmlage || fach;
const stimmlageShort = stimmlage.split(/[\s/]/)[0].slice(0, 5).toUpperCase();

const knownForText = primaryActor ? `Deutsche Stimme von ${primaryActor}` : '';

// Render the bio: split on blank lines into paragraphs, and highlight titles
// written in German „…" quotes (movies / series / games) as gold italics.
// Plain-text bios without blank lines or quotes still render fine (one block).
function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function highlightTitles(s: string): string {
  return s.replace(/„([^“„]+)“/g, '<em class="film">„$1“</em>');
}
const bioParas = (speaker.bio || '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
// Render paragraphs; the „ opener is a decorative mark, so close the quote
// with a matching “ at the very end of the last paragraph.
const bioHtml = bioParas
  .map((p, i) => {
    let inner = highlightTitles(escapeHtml(p));
    if (i === bioParas.length - 1) inner += '<span class="quote-close">“</span>';
    return `<p>${inner}</p>`;
  })
  .join('');

// Role label (used in the title, meta description and structured data)
const rolle = speaker.gender === 'F' ? 'Synchronsprecherin' : 'Synchronsprecher';

// Per-speaker structured data for Google (Person schema)
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: speaker.name,
  jobTitle: rolle,
  url: new URL(`/sprecher/${speaker.slug}/`, Astro.site).toString(),
  ...(hasPhoto ? { image: new URL(speaker.photo, Astro.site).toString() } : {}),
  worksFor: { '@type': 'Organization', name: 'Art of Voices', url: 'https://artofvoices.de' },
  ...(speaker.synchronkarteiUrl ? { sameAs: [speaker.synchronkarteiUrl] } : {}),
  knowsLanguage: 'de',
};
---

<Layout
  title={`${speaker.name} – ${rolle} | Art of Voices`}
  description={`${speaker.name} – ${rolle} bei Art of Voices.${knownForText ? ' ' + knownForText + '.' : ''}`}
  jsonLd={personJsonLd}
>
  <Navigation />

  <main class="dossier">
    <div class="dosB">

      {/* Top file bar */}
      <div class="dosB-bar">
        <div class="file">AOV · DOSSIER</div>
        <div class="clearance">
          <span>Art of Voices · Berlin</span>
          <span>{speaker.gender === 'F' ? 'Sprecherin' : 'Sprecher'}</span>
        </div>
      </div>

      {/* Hero — three-column dossier */}
      <section class="dosB-hero">
        <div class="dosB-card">
          <div class="lbl">Portrait · Pl. 01</div>
          <div class="frame">
            <div class="ticks">
              {Array.from({ length: 8 }).map(() => <span></span>)}
            </div>
            {hasPhoto ? (
              <img src={speaker.photo} alt={speaker.name} class="portrait-img" loading="eager" />
            ) : (
              <div class="glyph">{initials}</div>
            )}
            <div class="crosshair"></div>
            <div class="id-strip">
              <span>4·5</span>
              <span>{speaker.gender} · {stimmlageShort}</span>
            </div>
          </div>
          {hasPhoto && speaker.photo_credit && (
            <div class="photo-credit">Foto: {speaker.photo_credit}</div>
          )}
        </div>

        <div class="dosB-main">
          <div>
            <div class="crumb">
              <a href="/#roster">Sprecher / Sprecherinnen</a> <span class="gold">›</span> {genderLabel}
              <span class="gold">›</span> {speaker.name}
            </div>
            <h1>
              {firstName}{lastName && <br />}
              {lastName && <span class="last">{lastName}</span>}
            </h1>
            {primaryActor && (
              <div class="role-line">
                <span>Deutsche Stimme von</span>
                <span class="arr">→</span>
                <span class="name">{primaryActor}</span>
              </div>
            )}
          </div>
          <div class="dosB-attr">
            <div class="row"><div class="k">Stimmlage</div><div class="v gold">{stimmlage}</div></div>
            <div class="row"><div class="k">Sprache</div><div class="v">Deutsch</div></div>
          </div>
        </div>

        <div class="dosB-side">
          <div class="blk">
            <div class="lbl">Sprachprobe</div>
            <div class="val">{hasAudio ? 'Verfügbar ↓' : 'Auf Anfrage'}</div>
          </div>
          <div class="blk">
            <div class="lbl">Fachgebiet</div>
            <div class="val">Synchron · Hörbuch</div>
          </div>
          {speaker.synchronkarteiUrl && (
            <div class="blk">
              <div class="lbl">Filmografie</div>
              <div class="val">
                <a href={speaker.synchronkarteiUrl} target="_blank" rel="noopener noreferrer" class="side-link">
                  Synchronkartei.de →
                </a>
              </div>
            </div>
          )}
        </div>
      </section>

      {/* Vita */}
      {speaker.bio && (
        <section class="dosB-bio">
          <div class="marg">
            <div class="lbl">Vita</div>
          </div>
          <div class="body">
            <div class="qmark">„</div>
            <Fragment set:html={bioHtml} />
          </div>
        </section>
      )}

      {/* Audio — single hero waveform player */}
      {hasAudio && (
        <section class="dosB-audio" id="audio-section" data-audio={speaker.audio}>
          <div class="eyebrow">Hörprobe</div>
          <h2 class="section-title" style="margin-bottom: 40px;">Die <em>Stimme</em>.</h2>

          <div class="hero-track">
            <button class="play-lg" id="play-btn" aria-label={`Sprachprobe von ${speaker.name} abspielen`}>
              <svg class="ic-play" width="24" height="24" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.5 L10.2 6 L3 10.5 Z" fill="currentColor"/></svg>
              <svg class="ic-pause" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" style="display:none"><rect x="6" y="5" width="4" height="14" fill="currentColor"/><rect x="14" y="5" width="4" height="14" fill="currentColor"/></svg>
            </button>
            <div class="track-info">
              <div class="lbl">Sprachprobe</div>
              <div class="ttl">Stimme von {speaker.name}</div>
              <div class="meta">
                <span>Synchron</span><span>Art of Voices</span><span class="wave-time">0:00</span>
              </div>
            </div>
          </div>

          <div class="big-wave-meta">
            <span>00:00</span>
            <span class="wave-time-mid" style="color: var(--gold)">––</span>
            <span class="wave-dur">––</span>
          </div>
          <div class="big-wave" id="big-wave">
            <div class="head" id="wave-head" style="left: 0;"></div>
            {bigBars.map((ht) => (
              <span class="b" style={`height: ${Math.round(ht * 100)}%`}></span>
            ))}
          </div>
          <audio id="speaker-audio" src={speaker.audio} preload="none"></audio>
        </section>
      )}

      {/* Bekannt für — role index */}
      {knownForActors.length > 0 && (
        <section class="dosB-roles">
          <div class="head">
            <div>
              <div class="eyebrow">Bekannt für</div>
              <h2 class="section-title">Verzeichnis der <em>Stimmen</em>.</h2>
            </div>
            <div class="count">
              {String(knownForActors.length).padStart(2, '0')}
              <small>{knownForActors.length === 1 ? 'Rolle' : 'Schauspieler/Rollen'}</small>
            </div>
          </div>
          <div class="dosB-role-list">
            {knownForActors.map((actor, i) => {
              const parts = actor.split(' ');
              const a1 = parts[0];
              const a2 = parts.slice(1).join(' ');
              return (
                <a
                  class="dosB-role-row"
                  href={speaker.synchronkarteiUrl || '#'}
                  target={speaker.synchronkarteiUrl ? '_blank' : undefined}
                  rel={speaker.synchronkarteiUrl ? 'noopener noreferrer' : undefined}
                >
                  <div class="n">№ {String(i + 1).padStart(2, '0')}</div>
                  <div class="actor">{a1} {a2 && <em>{a2}</em>}</div>
                  <div class="desc">Deutsche Synchronstimme</div>
                  <div class="arr">→</div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      {/* Booking foot */}
      <section class="dosB-foot">
        <div class="blk">
          <div class="lbl">Booking</div>
          <div class="val gold">info@artofvoices.de</div>
        </div>
        <div class="blk">
          <div class="lbl">Direkt</div>
          <div class="val">+49 179 455 02 35</div>
        </div>
        <a class="btn" href="/#kontakt">Anfrage öffnen <span>→</span></a>
      </section>

      {/* Back link */}
      <div class="dosB-back">
        <a href="/#roster">← Zurück zu den Sprecher/innen</a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* ============================================================
     DOSSIER — speaker profile (ported from Claude Design v2,
     adapted to real data). Base font mono, serif for names.
     ============================================================ */
  .dossier { padding-top: 64px; }
  .dosB {
    --pad: 56px;
    font-family: var(--mono);
    background: var(--bg);
    color: var(--fg);
  }

  /* Top file bar */
  .dosB-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px var(--pad);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-dim);
  }
  .dosB-bar .file { color: var(--gold); }
  .dosB-bar .clearance { display: flex; gap: 24px; align-items: center; }
  .dosB-bar .clearance .dot {
    width: 6px; height: 6px; background: var(--gold); display: inline-block;
    margin-right: 8px; vertical-align: middle;
  }

  /* Hero */
  .dosB-hero {
    display: grid;
    grid-template-columns: 380px 1fr 280px;
    border-bottom: 1px solid var(--line);
  }
  .dosB-card {
    border-right: 1px solid var(--line);
    padding: 40px;
    background: var(--bg);
    position: relative;
  }
  .dosB-card .lbl {
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-dim); margin-bottom: 24px;
  }
  .dosB-card .frame {
    aspect-ratio: 4/5;
    background: linear-gradient(135deg, #2a2630 0%, #14121a 100%);
    position: relative; overflow: hidden;
    border: 1px solid var(--line);
  }
  .dosB-card .frame::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 35%, rgba(200,164,78,0.14) 0%, transparent 60%);
    z-index: 2; pointer-events: none;
  }
  .dosB-card .portrait-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center top;
    filter: grayscale(0.2) contrast(1.05);
    z-index: 1;
  }
  .dosB-card .frame .glyph {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-family: var(--serif); font-style: italic;
    font-size: 180px; color: rgba(232,232,240,0.10); z-index: 1;
  }
  .dosB-card .frame .crosshair {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      linear-gradient(to right, transparent calc(50% - 0.5px), rgba(200,164,78,0.25) calc(50% - 0.5px), rgba(200,164,78,0.25) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(35% - 0.5px), rgba(200,164,78,0.25) calc(35% - 0.5px), rgba(200,164,78,0.25) calc(35% + 0.5px), transparent calc(35% + 0.5px));
    mix-blend-mode: screen; opacity: 0.5;
  }
  .dosB-card .frame .ticks {
    position: absolute; left: 8px; top: 8px; bottom: 8px; width: 14px; z-index: 3;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .dosB-card .frame .ticks span { height: 1px; background: var(--gold-soft); width: 6px; }
  .dosB-card .frame .id-strip {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
    background: rgba(10,10,12,0.85);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    padding: 8px 12px; display: flex; justify-content: space-between;
    font-size: 8.5px; letter-spacing: 0.18em; color: var(--gold);
    border-top: 1px solid var(--gold-soft);
  }
  .dosB-card .photo-credit {
    margin-top: 12px;
    font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--fg-dim);
  }

  .dosB-main {
    padding: 40px 48px;
    border-right: 1px solid var(--line);
    display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
  }
  .dosB-main .crumb {
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--fg-dim);
  }
  .dosB-main .crumb a { color: var(--fg-mute); }
  .dosB-main .crumb a:hover { color: var(--fg); }
  .dosB-main .crumb .gold { color: var(--gold); margin: 0 4px; }
  .dosB-main h1 {
    font-family: var(--serif); font-weight: 400;
    font-size: 88px; line-height: 0.95; letter-spacing: -0.035em;
    margin: 18px 0 0; color: var(--fg);
  }
  .dosB-main h1 .last { font-style: italic; }
  .dosB-main .role-line {
    margin-top: 24px;
    display: inline-flex; align-items: center; gap: 14px;
    padding: 12px 18px;
    border: 1px solid var(--gold-soft);
    background: rgba(200,164,78,0.04);
    font-family: var(--serif); font-style: italic; font-size: 18px;
    color: var(--fg); letter-spacing: -0.005em;
  }
  .dosB-main .role-line .arr,
  .dosB-main .role-line .name { color: var(--gold); }

  .dosB-attr {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 40px;
  }
  .dosB-attr .row .k {
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-dim); display: flex; align-items: center; gap: 8px;
  }
  .dosB-attr .row .k::before { content: "›"; color: var(--gold); font-family: var(--serif); }
  .dosB-attr .row .v {
    margin-top: 6px; font-family: var(--serif); font-size: 19px;
    color: var(--fg); letter-spacing: -0.005em;
  }
  .dosB-attr .row .v.gold { color: var(--gold); font-style: italic; }

  .dosB-side {
    padding: 40px 32px; background: var(--bg-2);
    display: flex; flex-direction: column; gap: 28px;
  }
  .dosB-side .blk { border-top: 1px solid var(--gold-soft); padding-top: 14px; }
  .dosB-side .blk .lbl {
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 10px;
  }
  .dosB-side .blk .val {
    font-family: var(--serif); font-size: 17px; color: var(--fg);
    line-height: 1.4; letter-spacing: -0.005em;
  }
  .dosB-side .side-link { color: var(--gold); }
  .dosB-side .side-link:hover { color: var(--gold-light); }
  .dosB-side .id-block {
    margin-top: auto; padding-top: 20px;
    border-top: 1px dashed var(--line-strong);
    font-size: 9px; letter-spacing: 0.18em; color: var(--fg-dim); line-height: 1.7;
  }
  .dosB-side .id-block .row { display: flex; justify-content: space-between; }
  .dosB-side .id-block .row .v { color: var(--fg); }

  /* Bio */
  .dosB-bio {
    padding: 80px var(--pad);
    border-bottom: 1px solid var(--line);
    display: grid; grid-template-columns: 180px 1fr; gap: 60px; align-items: start;
  }
  .dosB-bio .marg {
    font-size: 9.5px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-dim); line-height: 1.7; padding-top: 20px;
    border-top: 1px solid var(--gold-soft);
  }
  .dosB-bio .marg .lbl { color: var(--gold); margin-bottom: 8px; }
  .dosB-bio .marg.right { text-align: right; }
  .dosB-bio .body { font-family: var(--sans); }
  .dosB-bio .body .qmark {
    font-family: var(--serif); font-style: italic; font-size: 64px;
    color: var(--gold); line-height: 0.5; margin-bottom: 24px;
  }
  /* Closing quote at the end of the last bio paragraph.
     :global() because the span is injected via set:html and doesn't get
     Astro's scoping attribute — without it the scoped rule never matches. */
  .dosB-bio .body :global(.quote-close) {
    font-family: var(--serif); font-style: italic;
    color: var(--gold); margin-left: 2px;
  }
  /* First paragraph = serif lead; following paragraphs = readable sans body */
  .dosB-bio .body p {
    font-family: var(--serif); font-size: 22px; line-height: 1.55;
    color: var(--fg); margin: 0 0 1em; letter-spacing: -0.005em; max-width: 62ch;
  }
  .dosB-bio .body p + p {
    font-family: var(--sans); font-size: 16px; line-height: 1.85;
    color: var(--fg-mute); margin-bottom: 1.1em;
  }
  .dosB-bio .body p:last-child { margin-bottom: 0; }
  /* Highlighted movie / series / game titles (also injected via set:html) */
  .dosB-bio .body :global(.film) { font-style: italic; color: var(--gold); }

  /* Audio */
  .dosB-audio { padding: 80px var(--pad); border-bottom: 1px solid var(--line); }
  .dosB-audio .hero-track {
    display: grid; grid-template-columns: auto 1fr; gap: 32px; align-items: center; margin-bottom: 40px;
  }
  .dosB-audio .play-lg {
    width: 88px; height: 88px; border: 1px solid var(--gold); border-radius: 50%;
    display: grid; place-items: center; color: var(--gold); position: relative; cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }
  .dosB-audio .play-lg:hover { background: var(--gold); color: var(--bg); }
  .dosB-audio .play-lg.playing { background: var(--gold); color: var(--bg); }
  .dosB-audio .play-lg::after {
    content: ""; position: absolute; inset: -8px;
    border: 1px dashed var(--gold-soft); border-radius: 50%; opacity: 0.5;
  }
  .dosB-audio .track-info .lbl {
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold);
  }
  .dosB-audio .track-info .ttl {
    font-family: var(--serif); font-size: 32px; margin-top: 6px; letter-spacing: -0.01em;
  }
  .dosB-audio .track-info .meta {
    margin-top: 8px; font-size: 11px; color: var(--fg-mute); letter-spacing: 0.05em;
    display: flex; gap: 16px;
  }
  .dosB-audio .track-info .meta span::after { content: "·"; margin-left: 16px; color: var(--gold); }
  .dosB-audio .track-info .meta span:last-child::after { content: ""; }
  .dosB-audio .big-wave-meta {
    display: flex; justify-content: space-between;
    font-size: 10px; letter-spacing: 0.18em; color: var(--fg-dim); margin-bottom: 8px;
  }
  .dosB-audio .big-wave {
    display: flex; align-items: center; gap: 2.5px; height: 80px; margin: 0 0 8px;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 12px 0; position: relative; cursor: pointer;
  }
  .dosB-audio .big-wave .b {
    flex: 1; min-width: 1.5px; background: var(--fg-dim); border-radius: 1px;
    transition: background 0.1s;
  }
  .dosB-audio .big-wave .b.on { background: var(--gold); }
  .dosB-audio .big-wave .head {
    position: absolute; top: 0; bottom: 0; width: 1px; background: var(--fg);
    transition: left 0.1s linear;
  }

  /* Roles index */
  .dosB-roles { padding: 80px var(--pad); border-bottom: 1px solid var(--line); }
  .dosB-roles .head {
    margin-bottom: 56px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 40px;
  }
  .dosB-roles .head .count {
    font-family: var(--serif); font-style: italic; font-size: 64px; color: var(--gold);
    letter-spacing: -0.02em; line-height: 1; text-align: right;
  }
  .dosB-roles .head .count small {
